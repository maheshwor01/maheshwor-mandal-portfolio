# Copy this file to .env for local development (`npm run dev`).
# Never commit the real .env file.

# Resend API key — required for the contact form to deliver email.
# Create a free key at https://resend.com
# For Gmail delivery to 345mandalmahesh@gmail.com, sign up in Resend with that
# Gmail address (or verify your own sending domain and set RESEND_FROM).
RESEND_API_KEY=re_your_real_key_here

# Destination inbox (defaults to this address if omitted)
CONTACT_TO_EMAIL=345mandalmahesh@gmail.com

# Optional. onboarding@resend.dev works without a custom domain.
# RESEND_FROM=Portfolio Contact Form <onboarding@resend.dev>
